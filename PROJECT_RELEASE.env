# Shared migration metadata. This branch is not a published runtime preset.
PROJECT_NAME="vLLM 2080 Ti Definitive Edition"
PROJECT_AUTHOR="github.com/weicj"
FORK_RELEASE="0.2.1-pre"
BASE_VLLM_VERSION="0.27.1"

# The upstream v0.27.1 build requirements pin torch==2.13.0. Validate this
# branch on the target lane; keep v0.1.x for the independently supported
# cu128 + torch 2.11 runtime.
PRIMARY_CUDA_VERSION="13.0"
PRIMARY_TORCH_VERSION="2.13.0"
PRIMARY_GCC_MAJOR="15"
PRIMARY_MIN_KERNEL_MAJOR="7"
LEGACY_RUNTIME_BRANCH="v0.1.x"
LEGACY_CUDA_VERSION="12.8"
LEGACY_TORCH_VERSION="2.11.0"
