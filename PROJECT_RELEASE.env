# Shared migration metadata. This branch is not a published runtime preset.
PROJECT_NAME="vLLM 2080 Ti Definitive Edition"
PROJECT_AUTHOR="github.com/weicj"
RUNTIME_IDENTITY="vllm-sm75-tp2-cu130"
FORK_RELEASE="0.2.1-pre2"
BASE_VLLM_VERSION="0.27.1"
VALIDATED_CUDA_VERSION="13.0"
VALIDATED_TORCH_VERSION="2.13.0+cu130"
VALIDATED_NVIDIA_DRIVER_VERSION="target-host-validated"

# The upstream v0.27.1 build requirements pin torch==2.13.0. This pre-release
# follows that current upstream runtime. The host target is intentionally newer
# than the upstream Docker base; the legacy lane remains a separate release
# branch rather than an install-time compatibility toggle.
PRIMARY_CUDA_VERSION="13.0"
PRIMARY_TORCH_VERSION="2.13.0"
PRIMARY_PYTHON_VERSION="3.12"
PRIMARY_UBUNTU_VERSION="26.04+"
PRIMARY_MIN_KERNEL_MAJOR="7"
PRIMARY_GCC_MAJOR="15"
UPSTREAM_DOCKER_CUDA_VERSION="13.0.3"
UPSTREAM_DOCKER_UBUNTU_VERSION="22.04"
LEGACY_RUNTIME_BRANCH="v0.1.x"
LEGACY_CUDA_VERSION="12.8"
LEGACY_TORCH_VERSION="2.11.0"
